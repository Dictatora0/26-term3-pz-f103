# 数据库
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/iboot?allowMultiQueries=true&useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DATABASE_USERNAME=root
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=iboot-local
JWT_ACCESS_TOKEN_TTL=1800
OAUTH2_ISSUER=iboot-oauth2
OAUTH2_CLIENT_ID=iboot-local-web
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback.html
OAUTH2_SCOPES=device.read device.control user.manage

# TLS
HTTPS_PORT=8443
TLS_KEY_STORE=file:/D:/Proj/5.29/deploy/iboot/certs/iboot-local.p12
TLS_KEY_STORE_PASSWORD=YOUR_TLS_KEY_STORE_PASSWORD
TLS_KEY_ALIAS=iboot-local
TEST_CAPTCHA=8888

# CORS
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
