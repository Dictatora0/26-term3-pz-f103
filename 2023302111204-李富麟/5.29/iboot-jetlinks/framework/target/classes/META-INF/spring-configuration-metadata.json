{
  "groups": [
    {
      "name": "framework",
      "type": "com.iteaj.framework.autoconfigure.FrameworkProperties",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.captcha",
      "type": "com.iteaj.framework.autoconfigure.FrameworkProperties$CaptchaConfig",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.security",
      "type": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.web",
      "type": "com.iteaj.framework.autoconfigure.FrameworkProperties$Web",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.web.session",
      "type": "com.iteaj.framework.autoconfigure.FrameworkProperties$Session",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Web"
    },
    {
      "name": "framework.web.upload",
      "type": "com.iteaj.framework.autoconfigure.FrameworkProperties$Upload",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Web"
    }
  ],
  "properties": [
    {
      "name": "framework.captcha.expire",
      "type": "java.lang.Long",
      "description": "有效期(秒) 默认1分钟",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$CaptchaConfig",
      "defaultValue": 0
    },
    {
      "name": "framework.captcha.type",
      "type": "com.iteaj.framework.captcha.CaptchaType",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$CaptchaConfig"
    },
    {
      "name": "framework.cluster",
      "type": "java.lang.Boolean",
      "description": "是否启用集群模式",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties",
      "defaultValue": false
    },
    {
      "name": "framework.domain",
      "type": "java.lang.String",
      "description": "当前系统访问地址,不包含uri (http:\/\/www.iteaj.com)",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.profiles",
      "type": "java.util.Map<java.lang.String,java.lang.Boolean>",
      "description": "启用的模块 配置格式如下：<hr>     framework.profiles.core=true     framework.profiles.framework=true",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.security.access-token-ttl",
      "type": "java.lang.Long",
      "description": "Access Token 有效期(秒)",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": 0
    },
    {
      "name": "framework.security.allow-legacy-header",
      "type": "java.lang.Boolean",
      "description": "是否允许兼容旧 access_token 请求头",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": true
    },
    {
      "name": "framework.security.authorization-header",
      "type": "java.lang.String",
      "description": "Bearer Token 请求头名称",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": "Authorization"
    },
    {
      "name": "framework.security.bearer-prefix",
      "type": "java.lang.String",
      "description": "Bearer Token 前缀",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": "Bearer "
    },
    {
      "name": "framework.security.enable-jwt",
      "type": "java.lang.Boolean",
      "description": "是否启用 Bearer JWT 认证",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": true
    },
    {
      "name": "framework.security.enable-oauth2",
      "type": "java.lang.Boolean",
      "description": "OAuth2\/JWT Access Token 签发开关",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": true
    },
    {
      "name": "framework.security.issuer",
      "type": "java.lang.String",
      "description": "JWT 签发者",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": "iboot-local"
    },
    {
      "name": "framework.security.jwt-secret",
      "type": "java.lang.String",
      "description": "JWT HMAC 密钥",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security"
    },
    {
      "name": "framework.security.oauth2-auto-approve",
      "type": "java.lang.Boolean",
      "description": "本地测试时是否允许授权页自动确认",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": true
    },
    {
      "name": "framework.security.oauth2-issuer",
      "type": "java.lang.String",
      "description": "OAuth2 授权服务器 issuer",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": "iboot-oauth2"
    },
    {
      "name": "framework.security.test-bypass-captcha",
      "type": "java.lang.Boolean",
      "description": "本地测试时固定验证码开关",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": false
    },
    {
      "name": "framework.security.test-captcha",
      "type": "java.lang.String",
      "description": "本地测试时固定验证码值",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Security",
      "defaultValue": "8888"
    },
    {
      "name": "framework.version",
      "type": "java.lang.String",
      "description": "版本",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties"
    },
    {
      "name": "framework.web.logger",
      "type": "java.lang.Boolean",
      "description": "启用日志记录",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Web",
      "defaultValue": false
    },
    {
      "name": "framework.web.session.automatic-token",
      "type": "java.lang.Boolean",
      "description": "自动选择token(浏览器使用cookie, app使用header)",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Session",
      "defaultValue": false
    },
    {
      "name": "framework.web.session.name",
      "type": "java.lang.String",
      "description": "缓存名称",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Session",
      "defaultValue": "IBoot:Session"
    },
    {
      "name": "framework.web.session.timeout",
      "type": "java.lang.Long",
      "description": "token过期时间(秒)",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Session",
      "defaultValue": 0
    },
    {
      "name": "framework.web.session.token-name",
      "type": "java.lang.String",
      "description": "token名称",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Session",
      "defaultValue": "access_token"
    },
    {
      "name": "framework.web.session.write-header",
      "type": "java.lang.Boolean",
      "description": "token是否写到header(为true优先读取header)",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Session",
      "defaultValue": false
    },
    {
      "name": "framework.web.upload.location",
      "type": "java.lang.String",
      "description": "文件存放路径必须以file: 或 classpath: 开头",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Upload"
    },
    {
      "name": "framework.web.upload.pattern",
      "type": "java.lang.String",
      "description": "文件访问pattern如 \/file\/**",
      "sourceType": "com.iteaj.framework.autoconfigure.FrameworkProperties$Upload"
    }
  ],
  "hints": []
}